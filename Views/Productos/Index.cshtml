@model IEnumerable<MiniMarketWebApp.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<!-- SweetAlert para mensajes -->
@if (TempData["success"] != null)
{
    <div id="swal-success-container">
        <script>
            Swal.fire({
                icon: 'success',
                title: '@TempData["success"]',
                timer: 1500,
                showConfirmButton: false
            });
        </script>
    </div>
}
@if (TempData["error"] != null)
{
    <div id="swal-error-container">
        <script>
            Swal.fire({
                icon: 'error',
                title: '@TempData["error"]',
                timer: 2000,
                showConfirmButton: false
            });
        </script>
    </div>
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fas fa-boxes me-2"></i>Gestión de Productos</h4>
            <a asp-action="Create" class="btn btn-light btn-sm fw-bold">
                <i class="fas fa-plus-circle me-1"></i> Nuevo Producto
            </a>
        </div>

        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center text-muted my-4">
                    <i class="fas fa-info-circle fa-2x mb-2"></i>
                    <p>No hay productos registrados aún.</p>
                </div>
            }
            else
            {
                <table class="table table-modern table-hover align-middle shadow-sm">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th>Precio (S/)</th>
                            <th>Stock</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.IdProducto</td>
                                <td>@item.Nombre</td>
                                <td>@item.Categoria?.Nombre</td>
                                <td>@item.Precio.ToString("0.00")</td>
                                <td>@item.Stock</td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.IdProducto"
                                       class="btn btn-warning btn-sm btn-action btn-edit me-1">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.IdProducto"
                                       class="btn btn-danger btn-sm btn-action btn-delete">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
